{
  "hosting": {
    "public": "www",
    "predeploy": ["npm run build:www"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.bat",
      "**/*.zip",
      "**/*.swf",
      "**/*.less",
      "**/*.scss"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
