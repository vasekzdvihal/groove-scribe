{
  "name": "groovescribe",
  "version": "1.0.0",
  "description": "Groove Scribe - drum notation and playback web application",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:verify": "node scripts/verify-e2e-mac.mjs",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/typecheck.mjs",
    "knip": "knip",
    "verify:fast": "npm run lint && npm run typecheck && npm run format:check && npm run knip && npm test",
    "verify": "npm run verify:fast && npm run test:e2e:verify && npm run test:rules && npm run test:cloud",
    "check": "npm run verify:fast",
    "build:www": "node scripts/build-www.mjs",
    "cap:sync": "npm run build:www && cap sync",
    "vendor:firebase": "node scripts/vendor-firebase.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-groovescribe 'vitest run --config vitest.rules.config.js'",
    "test:cloud": "firebase emulators:exec --only auth,firestore --project demo-groovescribe 'playwright test --config playwright.cloud.config.js'",
    "deploy": "firebase deploy --only hosting,firestore"
  },
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "6.2.1",
    "@capacitor/ios": "6.2.1",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.1.0",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.34.2",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "knip": "^6.26.0",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/core": "6.2.1"
  }
}
