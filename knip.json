{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "profile.html",
    "js/backToEditor.js",
    "scripts/*.{js,mjs}",
    "tests/**/*.test.js",
    "tests-e2e/**/*.spec.js",
    "tests-rules/**/*.test.js",
    "tests-cloud/**/*.spec.js",
    "*.config.js"
  ],
  "project": [
    "js/**/*.js",
    "tests/**/*.js",
    "tests-e2e/**/*.js",
    "tests-rules/**/*.js",
    "tests-cloud/**/*.js"
  ],
  "ignore": [
    "js/abc2svg-1.js",
    "js/pablo.js",
    "js/pablo.min.js",
    "js/jsmidgen.js",
    "js/unmute.js",
    "js/share-button.min.js",
    "js/*.min.js",
    "js/vendor/**"
  ],
  "ignoreDependencies": ["@capacitor/core", "@capacitor/android", "@capacitor/ios"]
}
